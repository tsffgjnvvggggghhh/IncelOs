#!/usr/bin/env bash
# IncelOS System Configuration Engine
# Reads user selections from /etc/incelos/setup.json and applies them to Arch Linux
set -e

CONFIG_FILE="/etc/incelos/setup.json"

if [ ! -f "$CONFIG_FILE" ]; then
    echo "[-] Config file not found at $CONFIG_FILE"
    exit 1
fi

echo "[+] IncelOS Engine: Applying user setup..."

# Parse JSON using python3
eval $(python3 -c "
import json
with open('$CONFIG_FILE') as f:
    d = json.load(f)
print(f'USER_NAME=\"{d.get(\"username\", \"user\")}\"')
print(f'USER_PASS=\"{d.get(\"password\", \"\")}\"')
print(f'USER_HOST=\"{d.get(\"hostname\", \"incelos-pc\")}\"')
print(f'USER_LANG=\"{d.get(\"language\", \"ru_RU.UTF-8\")}\"')
print(f'USER_KBD=\"{d.get(\"keyboard_toggle\", \"grp:alt_shift_toggle\")}\"')
print(f'USER_ACCENT=\"{d.get(\"accent_color\", \"#8b5cf6\")}\"')
print(f'USER_BROWSER=\"{d.get(\"browser\", \"brave\")}\"')
print(f'FEAT_GAMING=\"{d.get(\"gaming\", True)}\"')
print(f'FEAT_SNAPPER=\"{d.get(\"snapper\", True)}\"')
print(f'FEAT_ZRAM=\"{d.get(\"zram\", True)}\"')
")

# 1. Hostname
echo "$USER_HOST" > /etc/hostname

# 2. User Creation & Password
if ! id "$USER_NAME" &>/dev/null; then
    echo "[+] Creating user: $USER_NAME"
    useradd -m -G wheel,video,audio,storage,network -s /bin/bash "$USER_NAME"
fi

if [ -n "$USER_PASS" ]; then
    echo "[+] Setting user password..."
    echo "$USER_NAME:$USER_PASS" | chpasswd
    echo "root:$USER_PASS" | chpasswd
fi

# Enable sudo for wheel group
echo "%wheel ALL=(ALL:ALL) ALL" > /etc/sudoers.d/10-wheel
chmod 440 /etc/sudoers.d/10-wheel

# 3. Locale & Keyboard Layout
echo "[+] Configuring locale and keyboard..."
localectl set-locale LANG="$USER_LANG"
localectl set-x11-keymap us,ru pc105 "" "$USER_KBD"

# 4. KDE Plasma 6 Aesthetic Settings
USER_HOME="/home/$USER_NAME"
KDE_GLOBALS="$USER_HOME/.config/kdeglobals"
mkdir -p "$USER_HOME/.config"

# Accent Color & Dark Mode in KDE Plasma 6
cat <<EOF >> "$KDE_GLOBALS"
[General]
AccentColor=$USER_ACCENT
ColorScheme=BreezeDark

[KDE]
widgetStyle=Breeze
EOF

chown -R "$USER_NAME:$USER_NAME" "$USER_HOME/.config"

# 5. Browser Provisioning
echo "[+] Installing chosen browser: $USER_BROWSER..."
case "$USER_BROWSER" in
    brave)
        pacman -S --noconfirm --needed brave-bin || flatpak install -y flathub com.brave.Browser || true
        ;;
    firefox)
        pacman -S --noconfirm --needed firefox
        ;;
    zen)
        flatpak install -y flathub app.zen_browser.zen || true
        ;;
    chrome)
        pacman -S --noconfirm --needed google-chrome || flatpak install -y flathub com.google.Chrome || true
        ;;
esac

# 6. Gaming and Performance Tuning
if [ "$FEAT_GAMING" = "True" ]; then
    echo "[+] Activating Gaming Suite..."
    pacman -S --noconfirm --needed steam gamemode mangohud wine-staging || true
fi

if [ "$FEAT_ZRAM" = "True" ]; then
    echo "[+] Enabling ZRAM compression..."
    systemctl enable systemd-zram-setup@zram0.service || true
fi

if [ "$FEAT_SNAPPER" = "True" ]; then
    echo "[+] Enabling Btrfs Snapper automatic snapshots..."
    systemctl enable snapper-timeline.timer snapper-cleanup.timer || true
fi

# 7. Disable OOBE on next boot and start normal desktop session
systemctl disable incelos-welcome.service || true
rm -f /etc/systemd/system/incelos-welcome.service

echo "[✓] IncelOS Setup Applied Successfully!"
systemctl restart sddm || true
